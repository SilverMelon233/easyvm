walkthrough "what a reading looks like"
  resolution 1920x1080
  recording_resolution 1920x1080

  # ONE CAPTURE, TWO QUESTIONS ABOUT IT: the words in one place, the colour in another.
  read the middle of the screen as "label"
  read the bottom 4.5% of the screen as "panel"
    measuring mean spread sat flat_rows

  # `want:` USED TO COMBINE FOUR COMPARISONS INTO ONE BOOLEAN, AND NOTHING USED IT.
  # `check:` binds ONE boolean from ONE reading, so a combined verdict is several steps and one `if:` -
  # which is what a reader can follow, and what 29 walkthroughs actually do.
  step "the label says install"
    check == {name: label_ok, from: label, mode: contains, text: Install}
  step "the panel is a toolbar"
    see == {name: ratio, of: [mean], rect: [0, 0, 1920, 1080], rect_at: [1920, 1080], wait: 0}
