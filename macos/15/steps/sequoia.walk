walkthrough "macos 15 sequoia setup assistant"
  resolution 1920x1080
  password admin
  var shutdown == {default: ssh, from: args.shutdown}
  var user == {default: vmuser, from: args.user}
  header boot_disk == from_caller
  header boot_poll == 10
  header boot_timeout == 1800
  header ends == - finder
  header ends_at == [{name: "the login window's password field", rect: [880, 960, 1045, 1000], scale: 6, words: [enter, password]}]
  header ends_region == [0, 0, 700, 34]
  header ends_region_scale == 3
  header pane_limit == 3
  header stuck_after == 20
  header waits_for == [[country, region], [transfer, data], [spoken, languages], [accessibility, individual], [data, privacy], [create, mac, account], [sign, in, to, your, apple, account], [terms, conditions], [location, services], [time, zone], [analytics, improve], [screen, report], [look, appearance], [welcome, mac], [keyboard, select]]

  step "boot the disk"
    boot == true
    os == macos
    timeout == 900
  # THE GUEST NEEDS MINUTES BEFORE THE WIZARD IS ON SCREEN, AND NOTHING WAS WAITING FOR IT.
  #
  # THIS FILE DECLARES `boot_poll: 10` AND `boot_timeout: 1800` AT THE TOP, and NEITHER HAS AN
  # EXECUTOR: the two names exist only in the documentation key list and in the emitter's keep-list.
  # So the first `when:` below ran the instant qemu started, read the OpenCore screen, and found no
  # pane - and the same for every step after it:
  #
  #	read screen: 1 word(s): support.apple.com/mac/startup
  #	the apple account pane is gone [check]: done = false
  #	  (mode says_any: none of "update automatically" or "choose a look" or "welcome to mac"
  #	   in "support.apple.com/mac/startup")
  #
  # MEASURED on run 44147045702. THE DISK IS FINE: `macos15` boots to a desktop in the ssh leg, and
  # the qemu command line here is byte-identical to that one - the only difference was the wait.
  #
  # THE WAIT IS A `loop:` BECAUSE THAT IS THE VOCABULARY: a reading, a condition, a ceiling. 180
  # attempts of 10 seconds is the `boot_timeout: 1800` and `boot_poll: 10` the header asked for,
  # written where they can actually run.
  step "wait for the first wizard pane"
    loop == {check: {from: boot_screen, mode: says_any, name: up, words: [[analytics, improve], [privacy, fundamental], [spoken, languages], [transfer, data], [country, region], [create, mac, account], [welcome, mac], [look, appearance]]}, do: [{settle: 10}], max: 180, see: {name: boot_screen, of: [text], rect: [0, 0, 1920, 1080], rect_at: [1920, 1080], wait: 0}, until: {fact: up}}
    timeout == 2400
  step analytics
    do == [{click: [808, 513], settle: 3}, {click: [1306, 810], settle: 10}]
    when == [analytics, improve]
  step "data and privacy"
    click == [1306, 810]
    settle == 8
    when == [privacy, fundamental]
  step "written and spoken languages"
    click == [1306, 810]
    settle == 8
    when == [spoken, languages]
  step accessibility
    click == [1306, 806]
    settle == 12
    when == [accessibility, individual]
  step "transfer your data"
    do == [{click: [825, 669], settle: 4}, {click: [1306, 810], settle: 10}]
    when == [transfer, data]
  step "country or region"
    do == [{click: [900, 500], settle: 2}, {click: [900, 500], settle: 3, type: "united states"}, {click: [1306, 810], settle: 8}]
    when == [country, region]
  step "create a mac account"
    do == [{click: [945, 447], modifier: meta_l, settle: 3, type: "{{ user }}"}, {click: [850, 531], modifier: meta_l, settle: 3, type: "{{ password }}"}, {click: [1086, 531], modifier: meta_l, settle: 3, type: "{{ password }}"}, {click: [1306, 810], settle: 180}]
    rect == [300, 300, 1620, 340]
    rect_at == [1920, 1080]
    scale == 2
    when == [create, mac, account]
  step "enable location services"
    do == [{click: [1306, 810], settle: 6}, {click: [960, 632], settle: 3}, {key: ret, settle: 6}]
    when == [approximate, location]
  step "screen time"
    click == [619, 806]
    settle == 8
    when == [screen, report]
  step "time zone"
    click == [1306, 806]
    settle == 10
    when == [time, zone]
  step "choose your look"
    click == [1306, 805]
    settle == 12
    when == [look, appearance]
  step "terms and conditions"
    do == [{click: [1298, 806], settle: 8}, {click: [1019, 616], settle: 10}]
    when == [terms, conditions]
  step "welcome to mac"
    click == [960, 990]
    settle == 12
    when == [welcome, mac]
  step keyboard
    click == [1222, 818]
    settle == 12
    when == [keyboard, assistant]
  step "sign in to apple account"
    do == [{click: [620, 811], settle: 2}, {key: ret, settle: 3}, {click: [1026, 634], settle: 2}, {key: ret, settle: 2}]
    rect == [300, 420, 1620, 460]
    rect_at == [1920, 1080]
    scale == 2
    when == [sign, in, to, your, apple, account]
  # THE LOOP RE-CLASSIFIES, BECAUSE A GATE THAT MISSED ITS PANE NEVER COMES BACK.
  #
  # THIS STEP USED TO DO NOTHING BUT `settle: 3` AND READ AGAIN, so if ONE gate above failed to
  # click its pane, the walkthrough sat on that pane for twenty attempts and reported the condition
  # never holding. MEASURED on run 44178248696: the screen stayed on
  #
  #	read screen: 77 word(s): * Transfer Your Data to This Mac You can transfer ...
  #
  # for every attempt, because `transfer your data` had already run and could not run again.
  #
  # THE GATES ARE ONE-SHOT BY CONSTRUCTION - a `when:` step runs once, in file order - so the retry
  # has to come from a shape that reads the pane and clicks whatever it finds, which is what
  # `macos/15/steps/ssh.walk` does inside its own loop and what makes that file pass at 32/32.
  #
  # THIS IS THAT SHAPE, IN THE PANES THIS FILE ALREADY NAMES.
  step "the apple account pane is gone"
    loop == {check: {from: screen, mode: says_any, name: done, words: [[update, automatically], [choose, a, look], [welcome, to, mac]]}, do: [{name: "read the pane", see: {name: step_pane, of: [text], rect: [0, 0, 1920, 1080], rect_at: [1920, 1080], wait: 0}}, {check: {from: step_pane, mode: says, name: s_analytics, words: [analytics, improve]}, name: "classify - analytics"}, {check: {from: step_pane, mode: says, name: s_privacy, words: [privacy, fundamental]}, name: "classify - privacy"}, {check: {from: step_pane, mode: says, name: s_languages, words: [spoken, languages]}, name: "classify - languages"}, {check: {from: step_pane, mode: says, name: s_access, words: [accessibility, individual]}, name: "classify - accessibility"}, {check: {from: step_pane, mode: says, name: s_transfer, words: [transfer, data]}, name: "classify - transfer"}, {check: {from: step_pane, mode: says, name: s_country, words: [country, region]}, name: "classify - country"}, {check: {from: step_pane, mode: says, name: s_account, words: [create, mac, account]}, name: "classify - account"}, {check: {from: step_pane, mode: says, name: s_location, words: [location, services]}, name: "classify - location"}, {check: {from: step_pane, mode: says, name: s_screen, words: [screen, report]}, name: "classify - screen time"}, {check: {from: step_pane, mode: says, name: s_tz, words: [time, zone]}, name: "classify - time zone"}, {check: {from: step_pane, mode: says, name: s_look, words: [look, appearance]}, name: "classify - look"}, {check: {from: step_pane, mode: says, name: s_terms, words: [terms, conditions]}, name: "classify - terms"}, {check: {from: step_pane, mode: says, name: s_welcome, words: [welcome, mac]}, name: "classify - welcome"}, {check: {from: step_pane, mode: says, name: s_keyboard, words: [keyboard, assistant]}, name: "classify - keyboard"}, {check: {from: step_pane, mode: says, name: s_apple, words: [sign, in, to, your, apple, account]}, name: "classify - apple account"}, {check: {from: step_pane, mode: says, name: s_sheet, words: [are, you, sure]}, name: "classify - the apple sheet"}, {if: s_analytics, name: "analytics - untick sharing", then: [{click: [808, 513], name: "untick share analytics", settle: 3}, {click: [1306, 810], name: "analytics continue", settle: 10}]}, {if: s_privacy, name: "privacy - continue", then: [{click: [1306, 810], name: "privacy continue", settle: 8}]}, {if: s_languages, name: "languages - continue", then: [{click: [1306, 810], name: "languages continue", settle: 8}]}, {if: s_access, name: "accessibility - not now", then: [{click: [1306, 806], name: "accessibility not now", settle: 12}]}, {if: s_transfer, name: "transfer - choose none", then: [{click: [825, 669], name: "choose not to transfer", settle: 4}, {click: [1306, 810], name: "transfer continue", settle: 10}]}, {if: s_country, name: "country - united states", then: [{click: [900, 500], name: "focus the country list", settle: 2}, {click: [900, 500], name: "type the country", settle: 1}, {name: "country text", settle: 3, type: "united states"}, {click: [1306, 810], name: "country continue", settle: 8}]}, {if: s_account, name: "account - create it", then: [{click: [945, 447], name: "account user name", settle: 2}, {name: "account user text", settle: 3, type: "{{ user }}"}, {click: [850, 531], name: "account password", settle: 2}, {name: "account password text", settle: 3, type: "{{ password }}"}, {click: [1086, 531], name: "account verify", settle: 2}, {name: "account verify text", settle: 3, type: "{{ password }}"}, {click: [1306, 810], name: "account continue", settle: 180}]}, {if: s_location, name: "location - continue", then: [{click: [1306, 810], name: "location continue", settle: 6}, {click: [960, 632], name: "dont use focus", settle: 3}, {key: ret, name: "dont use confirm", settle: 6}]}, {if: s_screen, name: "screen time - later", then: [{click: [619, 806], name: "screen time later", settle: 8}]}, {if: s_tz, name: "time zone - continue", then: [{click: [1306, 806], name: "time zone continue", settle: 10}]}, {if: s_look, name: "look - continue", then: [{click: [1306, 805], name: "look continue", settle: 12}]}, {if: s_terms, name: "terms - agree", then: [{click: [1298, 806], name: "terms agree", settle: 8}, {click: [1019, 616], name: "licence agree", settle: 10}]}, {if: s_welcome, name: "welcome - continue", then: [{click: [960, 990], name: "welcome continue", settle: 12}]}, {if: s_keyboard, name: "keyboard - continue", then: [{click: [1222, 818], name: "keyboard continue", settle: 12}]}, {if: s_apple, name: "apple account - later", then: [{click: [619, 806], name: "apple account later", settle: 10}]}, {if: s_sheet, name: "apple sheet - skip", then: [{click: [1018, 641], name: "skip the apple account", settle: 10}]}], max: 60, see: {name: screen, of: [text], rect: [0, 0, 1920, 1080], rect_at: [1920, 1080], wait: 0}, until: {fact: done}}
  step "update mac automatically"
    click == [1306, 810]
    settle == 15
    when == [update, automatically]
  step "click the password field"
    click == [965, 981]
    settle == 1
    skip_when_unfinished == true
  step "type the password"
    settle == 1
    skip_when_unfinished == true
    type == '{{ password }}'
  step "press return"
    key == ret
    settle == 20
    skip_when_unfinished == true
  step "dismiss the overlays macOS puts up on a first login"
    do == [{click: [1228, 826], settle: 4}, {click: [1228, 826], settle: 4}, {click: [1228, 826], settle: 4}, {key: esc, settle: 2}, {key: meta_l+q, settle: 2}, {key: esc, settle: 2}]
    skip_when_unfinished == true
  step "wait for the desktop"
    desktop == macos
    skip_when_unfinished == true
    timeout == 300
  step "stop the machine"
    shutdown == '{{ shutdown }}'
    timeout == 300
