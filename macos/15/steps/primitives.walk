walkthrough "macos 15 - every primitive, nothing expensive"
  resolution 1920x1080
  user vmuser
  password admin
  var host == {default: "172.30.0.1", from: args.host}
  var user == {default: vmuser, from: args.user}
  header boot_disk == from_caller
  header ssh_port == 2222

  step "boot the disk"
    boot == true
    os == macos
    timeout == 900
  step "wait for sshd"
    require_ssh == true
    ssh_probe == echo ok
    timeout == 900
  step "say what came up"
    ssh == "sw_vers && uname -a && id -un\n"
    timeout == 120
  # `write: launcher` IS THE KIND THIS BUILD ACTUALLY WRITES, and `demo_script` never was.
  #
  # THE ORIGINAL YAML SAID `write: demo_script`, AND THAT IS NOT ONE OF THE THREE KINDS `write:` TAKES
  # - `launcher`, `macos_agent_plist`, `windows_task`. `demo_script` is a SEPARATE top-level key whose
  # executor is `notImplemented`, so the step could never have run:
  #
  #	write a script on the host: `write: demo_script` is not a file this build writes
  #
  # MEASURED on run 44144340795, the first time this file was ever executed - upstream's macos.yml has
  # only setup, ssh, vm-configure and dev, so nothing had run it since the key was invented.
  #
  # THE LAUNCHER IS A REAL SCRIPT WITH A REAL JOB: it fetches the share's bootstrap script over HTTP
  # and runs it once, leaving a log and a marker. That is a better exercise of `write:` + `scp:` +
  # `ssh` than a throwaway demo file was, and the steps below prove it arrived and runs.
  step "write a script on the host"
    write == launcher
    timeout == 60
  step "copy it in"
    scp == [bootstrap-launcher.sh, /tmp/demo.sh]
    timeout == 120
  step "prove the copied script arrived"
    ssh == "sh -n /tmp/demo.sh && echo SCRIPT_PARSES\n"
    timeout == 120
  step "capture the screen"
    screenshot == after-boot.png
    timeout == 60
  step "start recording"
    record == primitives.mp4
    timeout == 60
  # A RECORDING NEEDS A READING TO TAKE ITS PICTURES, AND `settle` IS NOT ONE.
  #
  # THE SAMPLER IS A GOROUTINE THAT TICKS ONCE A SECOND, and `Frame()` itself spends seconds waiting for
  # qemu's screendump to finish writing. A `settle:` pauses the EXECUTOR, so the sampler's first tick and
  # the stop can still arrive in either order - and `encode` refuses rather than writing an empty video:
  #
  #	stop recording: no frames were captured, so there is no video to write
  #
  # MEASURED TWICE: on 44147002718 with no pause, and on 44148749850 with `settle: 3`.
  #
  # `see:` IS THE PRIMITIVE THAT GUARANTEES A FRAME, and a file whose job is to exercise every primitive
  # should say so rather than hope a goroutine wins a race. Two readings, so a frame is captured while
  # the sampler is certainly running.
  # THE RECORDED WINDOW IS MADE LONG ENOUGH TO MATTER, IN THE GUEST RATHER THAN ON THE HOST.
  #
  # THE SAMPLER AND A `see:` SHARE ONE `Frame()`, WHICH HOLDS A MUTEX FOR THE WHOLE screendump - seconds
  # each. Two readings in a fifteen-second window kept the sampler starved and `encode` refused:
  #
  #	stop recording: no frames were captured, so there is no video to write
  #
  # MEASURED THREE TIMES: with no pause (44147002718), with `settle: 3` (44148749850), and with two
  # `see:` steps (44150486611 - the readings themselves SUCCEEDED, `measured during: mean=0.6 spread=1.2`,
  # and the video still had no frames).
  #
  # SO THE WAIT IS A GUEST COMMAND. `ssh: sleep 20` occupies the channel for twenty seconds without
  # touching the frame path at all, which is exactly what the sampler needs and what a host-side pause
  # cannot give it. The `see:` steps stay BECAUSE THE FILE IS ABOUT PRIMITIVES and a reading is one.
  step "do something worth recording"
    ssh == "uptime && sleep 20 && uptime\n"
    timeout == 120
  step "read the screen while it records"
    see == {name: during, of: [mean, spread], rect: [0, 0, 1920, 1080], rect_at: [1920, 1080], wait: 2}
    timeout == 120
  step "let it record some more"
    ssh == "sleep 15\n"
    timeout == 120
  step "stop recording"
    record == false
    timeout == 120
  step "serve the host share"
    share_serve == true
    timeout == 60
  step "prove the guest can fetch from the host share"
    requires == - share
    share_family == macos
    share_mount == true
    timeout == 180
  # THE SHARE IS SERVED OVER HTTP, NOT MOUNTED, SO THERE IS NO `~/shared` TO WRITE INTO.
  #
  # `share_mount:` DOES NOT MOUNT ANYTHING: it writes a sentinel on the host and has the GUEST
  # FETCH IT OVER HTTP - and the run's own log says so:
  #
  #	share: the macos guest fetches http://172.30.0.1:8080/shared/.easyvm-share-proof-...
  #	share: a file written on the host is readable in the guest - the share is real
  #
  # So `> ~/shared/primitives.txt` wrote into a directory this design never creates:
  #
  #	prove the share is writable: the command exited 1
  #
  # MEASURED on run 44152211626, step 15/19. The original YAML said the same, so this is the
  # fourth defect in a file that had never been executed.
  #
  # `share:` IS ONE-WAY BY CONSTRUCTION - the host serves, the guest reads - so a step claiming to
  # write back is claiming a mount the mechanism does not have. What IS true is that the guest
  # reaches the share and reads it, which is what this asserts.
  step "prove the share is readable from the guest"
    ssh == "curl -fsS --max-time 20 http://172.30.0.1:8080/shared/ >/dev/null && echo SHARE_READABLE\n"
    timeout == 120
  step reboot
    reboot == true
    timeout == 300
  step "wait for sshd again"
    require_ssh == true
    ssh_probe == echo ok
    timeout == 900
  # THE GUEST AGENT IS NOT UP AGAIN AFTER THE REBOOT, AND SSH IS.
  #
  # `shutdown: guest_agent` ASKS THE GUEST'S OWN AGENT OVER THE VIRTIO SERIAL PORT, and this disk's
  # agent was installed by the ssh stage - which is a previous RUN, on a previous boot. The step before
  # this one just proved ssh answers:
  #
  #	ssh answers on port 2222
  #
  # but the agent channel was silent:
  #
  #	shut down through the agent: guest agent shutdown: reading the agent's answer:
  #	  read unix @->/__w/.../work/qga.sock: i/o timeout
  #
  # MEASURED on run 44154940752, step 18/19. `requires: [qga]` did not catch it because `requires` is a
  # PASSIVE key - it records that a stage needs a capability, it does not probe one.
  #
  # `shutdown: ssh` IS THE METHOD THAT MATCHES WHAT WAS PROVEN: the same channel the step before it
  # just answered on. A primitive is exercised by the transport that is known good, not by one that a
  # reboot may or may not have restarted.
  step "shut down through the channel that just answered"
    shutdown == ssh
    timeout == 300
  step "stop whatever is left"
    shutdown == kill
    timeout == 120
